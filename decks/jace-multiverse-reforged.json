{
 "adds": [
  {
   "name": "Oath of Teferi",
   "status": "planned",
   "why": "Swap for Windcrag Siege. Jace activates loyalty twice a turn: +1 twice for 4 cards deep, or +1 then −3 to polymorph the same turn. The single biggest upgrade for a planeswalker commander."
  },
  {
   "name": "Divergent Transformations",
   "status": "planned",
   "why": "Swap for Cursed Mirror. Instant-speed polymorph on two of your creatures, ideal on tokens or a creature about to die. More Mass Polymorph effects is the deck's whole point."
  },
  {
   "name": "Agent of Treachery",
   "status": "planned",
   "why": "Swap for Ginger, Queen of Sweets. Every polymorph that flips this steals the best permanent at the table. Ginger is a 2/2 that dilutes the hits."
  },
  {
   "name": "Chaos Warp",
   "status": "planned",
   "why": "Swap for Brainsurge. Cheap removal for anything, and pointed at your own token it's a mini-polymorph."
  },
  {
   "name": "Grave Titan",
   "status": "planned",
   "why": "Swap for Dreadhorde Invasion. Top-tier polymorph hit that also makes Zombie fodder for the next Mass Polymorph."
  },
  {
   "name": "Sphinx of the Second Sun",
   "status": "planned",
   "why": "Swap for Omnath, Locus of the Void. A Sphinx, so The Ur-Sphinx discounts it; an extra untap and draw every turn. Omnath's colorless mana does little here."
  },
  {
   "name": "Inferno Titan",
   "status": "planned",
   "why": "Swap for Skrelv's Hive. Big hit that kills small creatures on arrival and on attack. Skrelv's Hive bleeds you for 1/1s."
  },
  {
   "name": "Rune-Scarred Demon",
   "status": "planned",
   "why": "Swap for Currency Converter. Polymorph hit that tutors the next piece (a sweeper, Oath, or Agent)."
  },
  {
   "name": "Sun Titan",
   "status": "planned",
   "why": "Swap for Staff of the Storyteller. Another real polymorph hit; brings back signets, Plan for All Outcomes, Oath and the cheap creatures."
  },
  {
   "name": "Tempt with Vengeance",
   "status": "planned",
   "why": "Swap for Kher Keep. X hasty tokens: polymorph fodder and a finisher. Drops you to 38 lands, plenty with 15 rocks."
  },
  {
   "name": "Ugin, the Ineffable",
   "status": "planned",
   "why": "Swap for Brainstorm. Colorless removal on a walker; Jace's −3 can also exile Ugin to polymorph into a creature or walker."
  },
  {
   "name": "Raffine's Tower",
   "status": "planned",
   "why": "Swap for Contaminated Landscape. Three of Jace's colours in one land with no fetch speed. Big fixing upgrade."
  },
  {
   "name": "Xander's Lounge",
   "status": "planned",
   "why": "Swap for Perilous Landscape. Same idea for the blue-black-red side."
  },
  {
   "name": "Raugrin Triome",
   "status": "planned",
   "why": "Swap for Reflecting Pool. Third triome; Reflecting Pool only copies colours you already have. Optional at $16."
  }
 ],
