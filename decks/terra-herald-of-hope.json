 "adds": [
  {
   "name": "Swords to Plowshares",
   "status": "owned (Jace precon)",
   "why": "High. One-mana instant exile. Suggested cut: Coin of Fate."
  },
  {
   "name": "Path to Exile",
   "status": "owned (Jace precon)",
   "why": "High. One-mana instant exile. Suggested cut: Key to the City."
  },
  {
   "name": "Archon of Cruelty",
   "status": "owned (Jace precon)",
   "why": "High. The best reanimation target here: on enter and attack an opponent sacrifices a creature or planeswalker, discards, loses 3; you draw and gain 3. Suggested cut: Umaro, Raging Yeti."
  },
  {
   "name": "Avacyn, Angel of Horror",
   "status": "owned (Jace precon)",
   "why": "Mid. 8-mana flier that returns your nontoken creatures when they die. Too costly to cast; a reanimation and Rise of the Dark Realms target. Suggested cut: Gogo, Mysterious Mime."
  },
  {
   "name": "Lingering Souls",
   "status": "owned (Jace precon)",
   "why": "Mid. Four 1/1 fliers from one card; if Terra mills it, you can still flash it back. Suggested cut: Mog, Moogle Warrior."
  },
  {
   "name": "Despark",
   "status": "owned (Jace precon)",
   "why": "Mid. Two-mana exile for anything with mana value 4 or more. Suggested cut: Espers to Magicite."
  },
  {
   "name": "Serra's Emissary",
   "status": "owned (Jace precon)",
   "why": "Mid. Reanimate it naming Creature and opponents' creatures can't touch you or your board. Suggested cut: Interceptor, Shadow's Hound."
  },
  {
   "name": "Reflecting Pool",
   "status": "owned (Jace precon)",
   "why": "Taps for any color your other lands make. In for a Plains."
  },
  {
   "name": "Fabled Passage",
   "status": "owned (Jace precon)",
   "why": "Fetches a basic; fills the graveyard count by one. In for a Plains."
  },
  {
   "name": "Caves of Koilos",
   "status": "owned (Jace precon)",
   "why": "W/B pain land. In for a Swamp."
  },
  {
   "name": "Turbulent Crater",
   "status": "owned (Jace precon)",
   "why": "B/R land. In for a Mountain if you want more fixing."
  },
  {
   "name": "Rakdos Signet",
   "status": "owned (Jace precon)",
   "why": "Low. Another rock if the deck feels slow."
  },
  {
   "name": "Archfiend of Despair",
   "status": "owned (Jace precon)",
   "why": "Low-mid. Reanimation target that stops lifegain and drains each end step."
  },
  {
   "name": "Overlord of the Mistmoors",
   "status": "owned (Jace precon)",
   "why": "Low-mid. Reanimated, it arrives as a full 6/6 and makes two 2/1 fliers."
  },
  {
   "name": "Elspeth, Sun's Champion",
   "status": "owned (Jace precon)",
   "why": "Low-mid. Strong on its own; doesn't use the graveyard plan."
  },
  {
   "name": "Flawless Maneuver",
   "status": "owned (Jace precon)",
   "why": "Low. Free indestructible for your creatures with Terra out; answers a wipe."
  }
 ],
 "notes": [
  "Nov 21, 2026: the stock Revival Trance precon (Final Fantasy VI), commander Terra, Herald of Hope; Celes, Rune Knight (the deck's second legend) is in the 99.",
  "Plan: Terra mills two each combat and brings back small creatures; the deck reanimates bigger threats (Sepulchral Primordial, Sun Titan, Archfiend of Depravity) and wins in combat. Reviews flag tension between Terra's small-creature recursion and the big reanimation targets.",
  "Cards to add are the Mardu-legal cards from Jace's Reality Fracture precon, which you opened for parts. Best of them: Swords to Plowshares, Path to Exile, Archon of Cruelty. Not simmed; there's no Terra simulator yet.",
  "Stock list includes 3 Mountain, 4 Plains and 3 Swamp. No Game Changers."
 ],
 "variants": []
}
