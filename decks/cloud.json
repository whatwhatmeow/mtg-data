{
 "adds": [
  {
   "name": "Swords to Plowshares",
   "status": "planned",
   "why": "Replaces Sword of the Animist (2nd copy). Commander is singleton, so the second copy isn't legal. Swap in 1-mana removal."
  },
  {
   "name": "Talisman of Conviction",
   "status": "planned",
   "why": "Replaces Bonders' Enclave. Colorless land in a 3-color deck. A 2-mana rock gets Cloud out a turn sooner."
  },
  {
   "name": "Austere Command",
   "status": "planned",
   "why": "Replaces Cultivate. He cut it from the precon, but with Vanquish the Horde and Decimate gone it's the deck's only board wipe, and it can spare Cloud (wipe creatures MV 3 or less)."
  },
  {
   "name": "Stoneforge Mystic",
   "status": "planned",
   "why": "Replaces Bronze Guardian. Bronze Guardian is a slow wall. Stoneforge tutors Colossus Hammer or a Sword and drops it in for 2 mana."
  },
  {
   "name": "Cloud, Midgar Mercenary",
   "status": "planned",
   "why": "Replaces Avalanche of Sector 7. Avalanche is a narrow artifact punisher. The other Cloud is a 2-mana Equipment tutor that doubles Equipment triggers."
  },
  {
   "name": "Mother of Runes",
   "status": "planned",
   "why": "Replaces Barret Wallace. Filler body. Mother makes Cloud dodge removal or blockers every turn."
  },
  {
   "name": "Brass Squire",
   "status": "planned",
   "why": "Replaces Helitrooper. Helitrooper is a 2/2 flier. Squire attaches any Equipment for free every turn, including Colossus Hammer (equip 8)."
  },
  {
   "name": "Sigarda's Aid",
   "status": "planned",
   "why": "Replaces Elena, Turk Recruit. Elena is low impact. Aid gives Equipment flash and attaches it free on entry."
  },
  {
   "name": "Steelshaper's Gift",
   "status": "planned",
   "why": "Replaces Professor Hojo. Hojo does little here. Gift is 1 mana for any Equipment."
  },
  {
   "name": "Hammer of Nazahn",
   "status": "planned",
   "why": "Replaces Cait Sith, Fortune Teller. Cait Sith is mostly flavor. Hammer auto-equips every Equipment that enters."
  },
  {
   "name": "Embercleave",
   "status": "planned",
   "why": "Replaces Summon: Kujata. Kujata is a 7-drop. Embercleave gives double strike and trample, usually for 2-3 mana in combat. With Colossus Hammer that's 30+ to the face."
  },
  {
   "name": "Fireshrieker",
   "status": "planned",
   "why": "Replaces Hellkite Tyrant. 6-mana dragon that doesn't help Cloud. Fireshrieker is double strike for 2 to equip."
  },
  {
   "name": "Akroma's Will",
   "status": "planned",
   "why": "Replaces Inspiring Statuary. Statuary is a weak mana rock. Akroma's Will is double strike plus protection: win or survive a wipe."
  },
  {
   "name": "Blackblade Reforged",
   "status": "planned",
   "why": "Replaces Conformer Shuriken. Shuriken is defensive. Blackblade is +1/+1 per land for equip 3 on Cloud."
  },
  {
   "name": "Buster Sword",
   "status": "planned",
   "why": "Replaces Hero's Heirloom. Heirloom is slow. Buster Sword is Cloud's own sword: big power plus free spells when he connects."
  },
  {
   "name": "Quietus Spike",
   "status": "planned",
   "why": "Replaces Wrecking Ball Arm. Arm sets power to 7 but costs a lot. Spike halves a player's life on every hit, and twice with double strike."
  },
  {
   "name": "Swiftfoot Boots",
   "status": "planned",
   "why": "Replaces Trailblazer's Boots. Nonbasic-landwalk only. Swiftfoot is a second haste + hexproof piece."
  },
  {
   "name": "Heroic Intervention",
   "status": "planned",
   "why": "Replaces Unfinished Business. 5-mana sorcery reanimation. Intervention stops a board wipe for 2."
  },
  {
   "name": "Boros Charm",
   "status": "planned",
   "why": "Replaces Vanquish the Horde. Wipes his own team. Boros Charm is instant double strike or indestructible, for 2."
  },
  {
   "name": "Path to Exile",
   "status": "planned",
   "why": "Replaces Decimate. Needs all four target types, often fizzles. Path is 1-mana exile."
  },
  {
   "name": "Shadowspear",
   "status": "planned",
   "why": "Replaces Dispatch. Dispatch only exiles with metalcraft. Shadowspear gives trample + lifelink for 1 so chump blocks stop working."
  },
  {
   "name": "Smothering Tithe",
   "status": "planned",
   "why": "Replaces Lifestream's Blessing. Expensive draw. Tithe is a Treasure engine (Game Changer #2; Gamble is #1)."
  },
  {
   "name": "Enlightened Tutor",
   "status": "planned",
   "why": "Replaces Ultimate Magic: Holy. Expensive protection. Enlightened Tutor finds Embercleave or Colossus Hammer for 1 (Game Changer #3)."
  },
  {
   "name": "Plaza of Heroes",
   "status": "planned",
   "why": "Land upgrade, replaces Scavenger Grounds. Any color for legendary spells, and can give Cloud hexproof + indestructible."
  },
  {
   "name": "Jetmir's Garden",
   "status": "planned",
   "why": "Land upgrade, replaces Ash Barrens. Naya triome; Forest type, so Nature's Lore can fetch it."
  },
  {
   "name": "Needleverge Pathway",
   "status": "planned",
   "why": "Land upgrade, replaces Path of Ancestry. Untapped R/W."
  },
  {
   "name": "Branchloft Pathway",
   "status": "planned",
   "why": "Land upgrade, replaces Radiant Grove. Untapped G/W."
  },
  {
   "name": "Cragcrown Pathway",
   "status": "planned",
   "why": "Land upgrade, replaces Sacred Peaks. Untapped R/G."
  },
  {
   "name": "Karplusan Forest",
   "status": "planned",
   "why": "Land upgrade, replaces Wooded Ridgeline. Untapped R/G painland, matches his Battlefield Forge and Brushland."
  }
 ],
